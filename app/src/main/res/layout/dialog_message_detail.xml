<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Accnotify.MessageDetailCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/message_detail_background"
    app:cardElevation="0dp"
    android:minWidth="260dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_card">

        <!-- Title -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="消息详情"
            android:gravity="left"
            android:textAlignment="viewStart"
            android:textIsSelectable="true"
            android:textColor="?attr/messageDetailTitleColor"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/dialogTime"
            android:gravity="left"
            android:textAlignment="viewStart"
            android:textIsSelectable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/message_detail_secondary"
            android:textSize="@dimen/text_caption"
            android:layout_marginBottom="@dimen/spacing_gap" />

        <!-- Message Body Container with constrained height -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="false"
                android:scrollbars="vertical"
                android:background="@color/message_detail_background"
                android:paddingVertical="@dimen/spacing_small">

                <TextView
                    android:id="@+id/dialogBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/message_detail_text"
                    android:textSize="@dimen/text_body"
                    android:gravity="left"
                    android:textAlignment="viewStart"
                    android:textColorLink="@color/message_detail_text"
                    android:lineSpacingMultiplier="1.3"
                    android:textIsSelectable="true" />

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_gap"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView

                android:paddingVertical="@dimen/control_padding_vertical"

                android:minHeight="@dimen/control_height"
                android:id="@+id/btnOpenUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_control"
                android:text="打开链接"
                android:textColor="@color/message_detail_text"
                android:textSize="@dimen/text_control"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="@dimen/spacing_small"
                android:visibility="gone" />

            <!-- Copy Button -->
            <TextView
                android:paddingVertical="@dimen/control_padding_vertical"
                android:minHeight="@dimen/control_height"
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_control"
                android:text="复制"
                android:textColor="@color/message_detail_text"
                android:textSize="@dimen/text_control"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="@dimen/spacing_small" />

            <!-- Close Button -->
            <TextView
                android:paddingVertical="@dimen/control_padding_vertical"
                android:minHeight="@dimen/control_height"
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_control"
                android:text="关闭"
                android:textColor="@color/message_detail_text"
                android:textSize="@dimen/text_control"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
