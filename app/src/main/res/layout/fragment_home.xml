<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_page"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- STATUS BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_clean_status"
            android:backgroundTint="@color/status_clean_connected_bg"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_home_card"
            android:paddingVertical="@dimen/spacing_home_card"
            android:id="@+id/statusContainer">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_fluent_wifi"
                app:tint="@color/status_clean_connected_text" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieStatus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_fileName="anim_connected.json" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_gap"
                android:text="服务已连接"
                android:textColor="@color/status_clean_connected_text"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>



        <!-- DEVICE IDENTITY CARD -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Accnotify.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_home_card">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_fluent_key"
                        app:tint="?attr/colorOnSurfaceVariant" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="设备身份 (Device Identity)"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <!-- Key Box -->
                <TextView android:id="@+id/tvEndpointId" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="同步连接后显示设备标识" android:textSize="@dimen/text_body" android:textColor="?attr/colorOnSurfaceVariant"
                    android:minHeight="@dimen/control_height" android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="@drawable/bg_clean_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/spacing_control"
                    android:paddingVertical="0dp">

                    <TextView
                        android:id="@+id/tvDeviceKey"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="@dimen/action_touch_size"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="选择设备 ID"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:text="Loading..."
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_body"
                        android:maxLines="1"
                        android:ellipsize="middle" />

                    <ImageView
                        android:id="@+id/btnCopyPushUrl"
                        android:layout_width="@dimen/action_touch_size"
                        android:layout_height="@dimen/action_touch_size"
                        android:src="@drawable/ic_fluent_copy"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/action_icon_padding"
                        android:contentDescription="复制推送链接"
                        android:focusable="true"
                        android:clickable="true" />
                        
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeviceKeyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="此 ID 用于接收推送消息，点击上方 ID 可切换。"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SERVER CONFIG CARD -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Accnotify.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_home_card">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_fluent_cloud"
                        app:tint="?attr/colorOnSurfaceVariant" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="当前服务器"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <!-- Server Input Box (Display only) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_gap"
                    android:background="@drawable/bg_clean_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/spacing_home_card"
                    android:paddingVertical="@dimen/spacing_control">

                    <TextView
                        android:id="@+id/tvServerUrl"
                        android:minHeight="32dp"
                        android:gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="https://an.trah.cn"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_body" />
                    
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_clean_status"
                        android:backgroundTint="@color/status_clean_connected_text"/>

                </LinearLayout>

                <TextView

                    android:paddingVertical="@dimen/control_padding_vertical"

                    android:minHeight="@dimen/control_height"
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_gap"
                    android:background="@drawable/bg_clean_button_primary"
                    android:gravity="center"
                    android:text="注册设备 / 同步连接"
                    android:textColor="@color/action_button_text"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_control"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Accnotify.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_gap">
            <TextView
                android:id="@+id/btnSenderEncryption"
                android:drawableStart="@drawable/ic_fluent_key"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/control_height"
                android:padding="@dimen/spacing_home_card"
                android:text="发送端加密密钥 · 未配置"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_control"
                android:background="?attr/selectableItemBackground" />
        </com.google.android.material.card.MaterialCardView>

        <!-- LEARN HOW TO USE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTutorial"
            style="@style/Widget.Accnotify.Card"
            android:stateListAnimator="@null"
            android:translationZ="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/spacing_home_card">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_clean_input">
                     <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fluent_book"
                        app:tint="?attr/colorOnSurface" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_gap"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="学习怎么用"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="了解如何发送推送消息"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
                
                <ImageView
                    android:layout_width="@dimen/icon_chevron_size"
                    android:layout_height="@dimen/icon_chevron_size"
                    android:src="@drawable/ic_fluent_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SYSTEM PERMISSIONS CARD -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Accnotify.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_home_card">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_gap">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_fluent_settings"
                        app:tint="?attr/colorOnSurfaceVariant" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="系统权限"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardKeepAliveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="@dimen/spacing_control">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_clean_input">
                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_fluent_power"
                            app:tint="?attr/colorOnSurface" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_gap"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="保活设置"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/keep_alive_restricted_settings_hint"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_chevron_size"
                        android:layout_height="@dimen/icon_chevron_size"
                        android:src="@drawable/ic_fluent_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <View 
                    android:layout_width="match_parent" 
                    android:layout_height="1dp"
                    android:background="@color/clean_divider"
                    android:layout_marginVertical="@dimen/spacing_small"/>

                <LinearLayout
                    android:id="@+id/cardNotificationPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="@dimen/spacing_control">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_clean_input">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notification"
                            app:tint="?attr/colorOnSurface" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_gap"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="通知权限"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="确保消息可以正常弹出提醒"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_chevron_size"
                        android:layout_height="@dimen/icon_chevron_size"
                        android:src="@drawable/ic_fluent_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <!-- Privacy Policy Only -->
        <TextView
            android:id="@+id/tvPrivacyPolicy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_section"
            android:text="隐私政策与条款"
            android:textColor="@color/clean_text_secondary"
            android:textSize="@dimen/text_caption"
            android:padding="@dimen/spacing_small" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
