<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Accnotify.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <!-- Message details follow day/night colors without Material elevation tint. -->
    <style name="Widget.Accnotify.MessageDetailCard" parent="CardView">
        <item name="cardBackgroundColor">@color/message_detail_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>
</resources>
