<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Accnotify.KeepAliveInstruction" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/keep_alive_text_size</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="Widget.Accnotify.KeepAliveScreenshot" parent="">
        <item name="android:layout_marginTop">@dimen/spacing_gap</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:maxHeight">360dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="Widget.Accnotify.KeepAliveAction" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:paddingVertical">@dimen/control_padding_vertical</item>
        <item name="android:layout_marginTop">@dimen/spacing_small</item>
        <item name="android:background">@drawable/bg_clean_button_primary</item>
        <item name="android:textColor">@color/action_button_text</item>
        <item name="android:textSize">@dimen/keep_alive_text_size</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.Accnotify.KeepAliveDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">@dimen/spacing_gap</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>
</resources>
